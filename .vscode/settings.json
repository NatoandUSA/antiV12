{
  "//": "Auto-uses the .venv interpreter and wires the Testing panel to the unittest suite.",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-s", "tests", "-p", "test_*.py"],
  "python.analysis.extraPaths": ["core", "research", "compliance", "listing", "creative", "economics"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },

  "// Terminal cleanup - removes the long extension spam when running tasks": "",
  "terminal.integrated.shellIntegration.enabled": false,
  "python.terminal.activateEnvironment": false
}

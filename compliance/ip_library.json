  "ambiguous_downgrade": {
    "_note": "These are real brands/franchises that ALSO collide with everyday apparel/care/gift words. Downgrade BLOCK -> REVIEW: safe when used generically, risky only as the brand.",
    "stitch": "Disney 'Stitch' — but 'stitch/stitched' is core embroidery vocabulary. Safe as embroidery, not the character.",
    "inside out": "Pixar 'Inside Out' — but 'wash inside out' is a care instruction. Safe as care text, not the movie.",
    "coach": "Coach (bag brand) — but 'coach' is a common job/gift word. Safe as the profession, not the brand.",
    "champion": "Champion (apparel brand) — but 'champion' is a common word. Safe generically, never as the blank brand on the label.",
    "frozen": "Disney 'Frozen' — but 'frozen' is a common word. Safe generically, not the movie/characters.",
    "sonic": "Sonic (game/drive-in) — safe as the word, not the franchise.",
    "supreme": "Supreme (streetwear) — but 'supreme comfort/soft' is common. Safe as the adjective, not the brand.",
    "tide": "Tide (detergent) / 'Roll Tide' — safe as ocean/word, not the brand or the school chant.",
    "gap": "Gap (apparel) — safe as the common word, not the brand.",
    "guess": "Guess (apparel) — safe as the verb, not the brand.",
    "boss": "Hugo Boss / 'Boss Babe' mark — 'boss' alone as a gift word is usually fine; avoid 'boss babe'.",
    "figs": "FIGS (scrubs brand) — safe as the fruit/word, risky in a nurse-scrub context. Verify."
  },
